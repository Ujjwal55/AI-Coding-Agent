GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional demo delay between node steps (seconds)
STEP_DELAY_SECONDS=10

# Local Qwen 0.5B fallback — OFF by default (often empty / useless for coding).
# Only enable if you have no cloud keys and accept low quality.
ENABLE_LOCAL_LLM_FALLBACK=false
